# Copy this to .env.local for local testing, and also add each of these
# in Vercel → your project → Settings → Environment Variables.

# From "npm run generate-vapid-keys" (a working pair is already given to
# you in README.md so you can skip this and just paste those in).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# A random string you make up yourself (any text). Protects the
# /api/send-notification endpoint from strangers triggering it.
CRON_SECRET=

# These two are added AUTOMATICALLY when you connect Vercel KV in the
# Vercel dashboard (Storage tab) — you don't type them in by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
